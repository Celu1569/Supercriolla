{
  "entities": {
    "SiteConfig": {
      "title": "SiteConfig",
      "description": "Radio station configuration",
      "type": "object",
      "properties": {
        "general": {
          "type": "object",
          "description": "General station details"
        },
        "navigation": {
          "type": "object",
          "description": "Navigation settings"
        },
        "appearance": {
          "type": "object",
          "description": "Visual appearance"
        },
        "content": {
          "type": "object",
          "description": "Sections content"
        },
        "social": {
          "type": "object",
          "description": "Social media links"
        },
        "advertising": {
          "type": "object",
          "description": "Sidebar advertising configuration"
        },
        "songRequest": {
          "type": "object",
          "description": "WhatsApp song request form configuration"
        },
        "pushNotifications": {
          "type": "object",
          "description": "Live push notifications settings and active broadcast"
        }
      }
    },
    "ListenerStat": {
      "title": "ListenerStat",
      "description": "Daily listener engagement and trend metrics",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Calendar date in YYYY-MM-DD format"
        },
        "totalListeners": {
          "type": "number",
          "description": "Total listener sessions recorded for the day"
        },
        "peakListeners": {
          "type": "number",
          "description": "Highest simultaneous listener count recorded"
        },
        "songRequests": {
          "type": "number",
          "description": "WhatsApp song requests submitted"
        },
        "chatMessages": {
          "type": "number",
          "description": "Chat messages sent"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["date", "totalListeners"]
    }
  },
  "firestore": {
    "/settings/{settingId}": {
      "schema": {
        "$ref": "SiteConfig"
      },
      "description": "Stores site wide settings"
    },
    "/listener_stats/{statDate}": {
      "schema": {
        "$ref": "ListenerStat"
      },
      "description": "Stores daily listener trends for the last 7 days dashboard"
    }
  }
}
